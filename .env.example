APP_NAME="Kulmis Market"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Addis_Ababa
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Docker: DB_HOST=mysql. Shared hosting: the host your panel gives you.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=kulmis
DB_USERNAME=kulmis
DB_PASSWORD=secret

SESSION_DRIVER=privacy-database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=kulmis

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@kulmis.market"
MAIL_FROM_NAME="${APP_NAME}"

# Shop
SHOP_CURRENCY=ETB

# Shared hosting without a long-running worker: the scheduler drains the
# queue every minute. On a VPS run `php artisan queue:work` under
# supervisor/systemd and set this to false.
QUEUE_VIA_SCHEDULER=true

# Payments, SMS and Telegram keys are added by their PRs (8, 7, 10).

VITE_APP_NAME="${APP_NAME}"

# Admin
ADMIN_REQUIRE_2FA=true
SANCTUM_STATEFUL_DOMAINS=localhost:8080,localhost
