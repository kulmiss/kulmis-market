APP_NAME="Kulmis Market"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Addis_Ababa
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Docker: DB_HOST=mysql. Shared hosting: the host your panel gives you.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=kulmis-market
DB_USERNAME=kulmis
DB_PASSWORD=secret

SESSION_DRIVER=privacy-database
SESSION_COOKIE=km_session
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=kulmis

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@kulmis.market"
MAIL_FROM_NAME="${APP_NAME}"

# Shop
SHOP_CURRENCY=ETB

# Shared hosting without a long-running worker: the scheduler drains the
# queue every minute. On a VPS run `php artisan queue:work` under
# supervisor/systemd and set this to false.
QUEUE_VIA_SCHEDULER=true

# Payments, SMS and Telegram keys are added by their PRs (8, 7, 10).

VITE_APP_NAME="${APP_NAME}"

# Admin
ADMIN_REQUIRE_2FA=true
SANCTUM_STATEFUL_DOMAINS=localhost:8080,localhost

# SMS: log (default) or http (generic JSON API: POST {to,message,sender} + Bearer token)
SMS_DRIVER=log
SMS_URL=
SMS_TOKEN=
SMS_SENDER=KulmisMkt

# Telegram bot (create with @BotFather; add the bot as admin of your private channel)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHANNEL_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_CHAT_ID=

# Chapa (use test keys first: CHASECK_TEST-...). Webhook URL to set in the Chapa dashboard:
#   https://your-domain/api/v1/webhooks/chapa   (same secret as CHAPA_WEBHOOK_SECRET)
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=
CHAPA_REFUND_API=true

# Static page cache for guest pages (see docs/deploy.md for server rules)
PAGE_CACHE=true

# Encrypted backups: php artisan km:backup-key
BACKUP_KEY=

# Minimum length for admin passwords (km:create-admin).
ADMIN_PASSWORD_MIN=5

# Docker only: ports on your computer. Change one if Docker says
# "ports are not available" (another program is using it).
# If you change APP_PORT, also change APP_URL and SANCTUM_STATEFUL_DOMAINS.
APP_PORT=8080
DB_FORWARD_PORT=3307
MAILPIT_PORT=8025
